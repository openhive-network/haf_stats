[sqlfluff]
dialect = postgres
templater = raw
max_line_length = 120
indent_unit = space
tab_space_size = 4
exclude_rules = references.keywords, references.quoting
# 0 disables the file-size skip so large processors (e.g. process_content_stats.sql,
# ~24k) are actually linted. endpoint_schema.sql stays excluded via .sqlfluffignore.
large_file_skip_byte_limit = 0

[sqlfluff:rules:layout.indent]
indent_unit = space

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
capitalisation_policy = upper
