# nginx config for the haf_stats PostgREST URL rewriter.
# Provides clean REST URLs (e.g. /network/rc-utilization) that map to PostgREST /rpc/ calls,
# per the rewrite rules generated from the OpenAPI annotations (endpoints/rewrite_rules.conf).
# Placeholders (${...}) are substituted at startup by docker/rewriter_entrypoint.sh.
worker_processes  2;
error_log /dev/stdout info;
worker_rlimit_nofile 8192;

events {
  worker_connections 4096;
}

http {
    access_log /dev/stdout;

    # hive.rpc_form ships in the base image (common-ci-configuration/nginx);
    # rpc_arguments.lua is generated beside rewrite_rules.conf by scripts/openapi_rewrite.sh.
    init_by_lua_block {
        rpc_form = require "hive.rpc_form"
        rpc_arguments = dofile(ngx.config.prefix() .. "conf/rpc_arguments.lua")
    }

    server {
        listen 0.0.0.0:80 default_server;
        server_name _;

        location / {
            include rewrite_rules.conf;
            # ${REWRITE_LOG} is replaced by the entrypoint (rewrite logging on/off).
            ${REWRITE_LOG}

            # A GET or HEAD of /rpc/<function> goes upstream as a form POST of the
            # arguments the function declares, so PostgREST reads an argument value
            # starting with an operator (not., eq., ...) as the value, not a filter;
            # every other parameter (select, order, column filters) stays in the query.
            rewrite_by_lua_block { rpc_form.forward(rpc_arguments) }
            header_filter_by_lua_block { rpc_form.restore_head() }

            proxy_pass http://${POSTGREST_HOST}:${POSTGREST_PORT};

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_hide_header Content-Location;
            proxy_set_header Connection "";
            proxy_http_version 1.1;
        }
    }

    # lightweight health endpoint for container/orchestrator checks
    server {
        listen 0.0.0.0:81;
        location /health {
            return 204;
        }
    }
}
