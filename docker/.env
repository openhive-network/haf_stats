# HAF base image — pin to a specific commit SHA for reproducibility.
# CI does NOT read this: it resolves the image per pipeline via find_haf_image (which tracks
# hive/haf develop, falling back to HAF_FALLBACK_TAGS in .gitlab-ci.yml when the registry has
# no develop image). Bump both together, or CI and the local/production stack drift apart.
HAF_REGISTRY=registry.gitlab.syncad.com/hive
HAF_VERSION=1.28.6

# HAF command for the production stack (`docker compose up -d`). Mirrors
# balance_tracker: the chain-state size is --shared-file-size here. 1G + the 5M
# stop-at-block match this repo's reference depth; for a fuller/mainnet node raise
# --shared-file-size (≈25+ GiB and growing) and drop/extend --stop-at-block. CI
# does not use this — its sync/test stacks override the command with --skip-hived.
HAF_COMMAND=--shared-file-size=1G --plugin database_api --replay --stop-at-block=5000000

# haf_stats images. These two move BOTH the app image and the rewriter, which is
# published as <registry>/haf_stats/postgrest-rewriter -- one registry and one version
# for the pair, the same way haf_api_node pins them. (Renamed from haf_stats/rewriter by
# #83; SHAs built before the rename exist only under the old name -- see README.)
# `latest` now resolves for BOTH images: publish_latest republishes it on every green
# develop pipeline (#66), so it tracks develop HEAD -- and it is the SHIPPED DEFAULT
# below. `cd docker && docker compose up -d`, which README calls the production path,
# therefore follows develop unless you pin. Pin a version or a SHA for anything you
# need to reproduce. This line used to read "CI publishes only SHA tags, so latest
# resolves for neither image today", which is why that path used to fail loudly rather
# than move underneath you.
HAF_STATS_REGISTRY=registry.gitlab.syncad.com/hive
HAF_STATS_VERSION=latest

# PostgREST
POSTGREST_VERSION=v12.2.3

# Host ports. The REWRITER is the front door on 3001 -- the base URL the README
# documents -- and PostgREST is on 3000 for raw /rpc/ access.
#
# These two must not be equal: compose publishes both, and `docker compose config` does
# NOT check host-port uniqueness, so a collision here starts nothing and passes lint.
# tests/unit/test_compose_contract.py is what catches it.
API_PORT=3000
REWRITER_PORT=3001
