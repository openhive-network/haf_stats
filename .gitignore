# Docker
docker/blockchain
docker/.env.local

# Python
__pycache__/
*.pyc
.venv/

# Fetched on demand by scripts/openapi_rewrite.sh (from common-ci-configuration)
scripts/process_openapi.py

# Test output
tests/tavern/.pytest_cache/
*.log

# Created by scripts/openapi_rewrite.sh: a private virtualenv for the pinned
# generator dependencies, the generator's staging tree, and the rewrite_rules.conf
# the generator drops in the CWD. All three are removed by the script's EXIT trap;
# they are ignored as well because the repo-root one in particular lands where a
# `git add -A` would sweep it up, and the drift gate is scoped to endpoints/ so it
# would not be seen there either.
.openapi_venv/
scripts/openapi_out/
/rewrite_rules.conf
