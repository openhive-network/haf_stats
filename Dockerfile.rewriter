# Builds the haf_stats PostgREST URL rewriter image (openresty).
# It serves clean REST URLs that map to PostgREST /rpc/ calls, so the public API matches the
# convention used by the other HAF apps (block_explorer, balance_tracker) rather than exposing
# raw /rpc/<function> endpoints. The rewrite rules are generated from the OpenAPI annotations in
# endpoints/endpoint_schema.sql via scripts/openapi_rewrite.sh (-> endpoints/rewrite_rules.conf),
# as is the map of each function's declared arguments (-> endpoints/rpc_arguments.lua) that the
# base image's hive.rpc_form module forwards as a form POST body.
FROM registry.gitlab.syncad.com/hive/common-ci-configuration/nginx:1d952fd19118762d0e66f91953e194ff08e69bb0

COPY docker/haf_stats_nginx.conf.template /usr/local/openresty/nginx/conf/nginx.conf.template
COPY docker/rewriter_entrypoint.sh /entrypoint.sh
COPY endpoints/rewrite_rules.conf /usr/local/openresty/nginx/conf/rewrite_rules.conf
COPY endpoints/rpc_arguments.lua /usr/local/openresty/nginx/conf/rpc_arguments.lua
RUN chmod +x /entrypoint.sh

CMD ["/entrypoint.sh"]

ARG BUILD_TIME
ARG GIT_COMMIT_SHA
ARG GIT_CURRENT_BRANCH
ARG GIT_LAST_LOG_MESSAGE
ARG GIT_LAST_COMMITTER
ARG GIT_LAST_COMMIT_DATE
ARG API_VERSION="0.0.0-dev"
LABEL org.opencontainers.image.created="$BUILD_TIME"
LABEL org.opencontainers.image.url="https://hive.io/"
LABEL org.opencontainers.image.documentation="https://gitlab.syncad.com/hive/haf_stats"
LABEL org.opencontainers.image.source="https://gitlab.syncad.com/hive/haf_stats"
LABEL org.opencontainers.image.version="$API_VERSION"
LABEL org.opencontainers.image.revision="$GIT_COMMIT_SHA"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.ref.name="HAF Stats"
LABEL org.opencontainers.image.title="HAF Stats PostgREST URL Rewriter Image"
LABEL org.opencontainers.image.description="Rewrites REST calls to provide more natural REST URLs than PostgREST alone allows"
LABEL io.hive.image.branch="$GIT_CURRENT_BRANCH"
LABEL io.hive.image.commit.log_message="$GIT_LAST_LOG_MESSAGE"
LABEL io.hive.image.commit.author="$GIT_LAST_COMMITTER"
LABEL io.hive.image.commit.date="$GIT_LAST_COMMIT_DATE"
